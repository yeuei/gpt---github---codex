#!/bin/zsh
set -euo pipefail

# Optional local-agent entrypoint for the ChatGPT → Agent route.
# The trigger passes the handoff prompt as the remaining argv. Keep Codex's
# command approval policy visible; do not use a bypass flag here.
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
codex_bin="${CODEX_BIN:-$(command -v codex)}"
exec "$codex_bin" exec \
  --cd "$repo_dir" \
  --sandbox workspace-write \
  --ask-for-approval on-request \
  "$@"
